{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ホスト名は `yaritai100list.aiandrox.workers.dev`。
  // カスタムドメインは使わない（TECH_STACK.md §8 の決定事項）。
  // サブドメイン `aiandrox` を変えると共有リンクが死ぬので変更しない。
  "name": "yaritai100list",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",

  // @sentry/cloudflare が node:async_hooks を import するため必須。
  // 外すと `vite dev` の起動時点で
  // 「Failed to load url node:async_hooks」で落ちる。
  //
  // ⚠️ このフラグが無くても**テストは緑になる**（vitest-pool-workers 側で
  // Node の互換が効いているため）。テストだけでは検知できない設定。
  "compatibility_flags": ["nodejs_compat"],

  // account_id はここに書かない。ローカル開発（wrangler dev）には不要で、
  // デプロイ時は CLOUDFLARE_ACCOUNT_ID を環境変数で渡す。
  "observability": {
    "enabled": true,
  },

  // 秘密ではない値。**ローカルでは .dev.vars が上書きする**（5173 番）。
  // OAuth のコールバックの基点になるため、リクエストの Host ヘッダからは導出しない
  // （Host は攻撃者が差し替えられる）。
  "vars": {
    "BETTER_AUTH_URL": "https://yaritai100list.aiandrox.workers.dev",

    // 画像生成サービス（Deno Deploy）。**秘密の値ではないのでここに書く**（#172）。
    // 一緒に使う `RENDER_HMAC_SECRET` の方はシークレット（`wrangler secret put`）。
    //
    // ホスト名は `{アプリ名}.{org slug}.deno.net`。
    // **org slug を変えるとここも変える**（`docs/console-settings.md`）。
    "RENDER_URL": "https://yaritai100list-render.aiandrox.deno.net",
  },

  // SPA を Workers から配信する。ビルド出力のディレクトリは
  // @cloudflare/vite-plugin が設定するため、ここには書かない。
  //
  // not_found_handling: single-page-application は、静的ファイルに当たらない
  // パスで index.html を返す。これで SPA のクライアントルーティングが動く。
  //
  // 🔴 run_worker_first に書いたパスだけが Worker のコードに届く。
  // **サーバー側で処理するルートを増やすときは、ここにも足すこと。**
  // 足し忘れると Worker には届かず、SPA の index.html が返る（404 にならないので気づきにくい）。
  //
  // 予定しているサーバー側のルート（PRODUCT_SPEC.md §7 の URL 表）:
  // - /api/*            JSON API・認証のコールバック（このコミットで有効）
  // - /share/:shareId   共有公開ページの SSR（#137 で有効）
  // - /og/:shareId      OGP 画像（#8）
  // - /api/lists/:listId/image  ダウンロード画像（#9）。**/api/* に入るので追加は不要**
  //
  // 全部を Worker に通す（run_worker_first: true）ことはしない。
  // 静的ファイルの配信まで Worker の実行回数を消費するため、無料枠に効く。
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/share/*", "/og/*"],
  },

  /**
   * Workers AI（#253 / 親 #252）。取り入れ面に出してよいかの判定に使う。
   *
   * 無料枠は **10,000 Neurons/日**（2026-08-10 に確認）。
   * 判定は**新しい本文にしか掛けない**（`wish_texts` にキャッシュする）ので、
   * この枠で足りる。
   */
  "ai": { "binding": "AI" },

  /**
   * 判定を埋めるバッチ（#253）。
   *
   * ⚠️ **Free では1実行あたりサブリクエストが 50、CPU が 10ms**（2026-08-10 に確認）。
   * 1回で捌けるのは十数件。
   *
   * 🔴 **間隔を決めているのは Neurons の枠**（2026-08-10 に確認）。
   * 1回の判定で約 20 Neurons（入力 26,668/M・出力 204,805/M）なので、
   * **10,000 Neurons/日 ＝ 1日およそ 500 件。**
   * 1時間ごと × 15件 = 360件/日 で枠の内側に収まる。
   * 10分ごとにすると 2,160件/日 になり、**溜まっているときに半日で枠を焼く。**
   *
   * ⚠️ **プールの作り直しも同じ実行でやる**（#254 の `runPoolBatch`）。
   * あちらは SQL 1文で、CPU も無料枠もほとんど使わない。
   * 日次にすると**デプロイ直後に丸1日プールが空**になるので、判定と同じ間隔にしてある。
   */
  "triggers": { "crons": ["0 * * * *"] },

  // 作成系（リスト・項目・取り込み）のレート制限。**コンソールではなくここで設定する。**
  //
  // ⚠️ **計測期間は 10 秒か 60 秒しか選べない。** 日次の上限が要るようになったら
  // D1 のカウンタを併用する。
  //
  // 60 秒で 60 回。手で書く分には当たらず、走らせた分は止まる程度に置いている。
  // キーは利用者ごと（`src/rate-limit.ts`）。**他人の操作で自分が止まらない。**
  //
  // ⚠️ **テストはここの値を使わない**（#215）。枠の数だけ往復するので遅すぎた。
  // テスト用の小さい枠は `vitest.config.ts` の `ratelimits`。**両方を直す必要がある。**
  "ratelimits": [
    {
      "name": "CREATE_RATE_LIMIT",
      // 名前空間の識別子。**他のバインディングと重複しない整数**であればよい
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      // 画像出力（#192）。**作成系より厳しくする。**
      // 1回で 100 項目をラスタライズするので、他の操作とは重さが桁違い
      // （生成サービスの CPU 枠を溶かす。`TECH_STACK.md` §9）。
      //
      // 60 秒で 10 回。押し直す分には当たらない。
      "name": "IMAGE_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yaritai100list",
      // 秘密の値ではないのでコミットしてよい。ローカル開発では使われない。
      // 現在値の記録は docs/console-settings.md（リージョンは APAC）。
      "database_id": "78718e38-9558-416b-b7c2-61b6a00be62d",
      "migrations_dir": "migrations",
    },
  ],

  /**
   * 🔴 **テスト専用の環境。AI バインディングを持たない**（#253）。
   *
   * `vitest-pool-workers` は **AI を「ローカル模倣が存在しないバインディング」として
   * 無条件にリモート扱い**にし、`CLOUDFLARE_API_TOKEN` を要求する
   * （`pickRemoteBindings`）。opt-out する設定は無い。
   * **CI にはトークンが無いので、テストが1件も起動しなくなる**（2026-08-10 に踏んだ）。
   *
   * ⚠️ **名前付き環境はバインディングを引き継がない。**
   * ここに書いていないものはテストから見えない。
   * **上にバインディングを足したら、ここにも足すこと**（足し忘れるとテストが落ちるので気づける）。
   *
   * `ratelimits` は**テストが `vitest.config.ts` で上書きする**（枠を小さくしないと
   * CI で遅すぎる。#215）が、**ここにも書く。** 書かないと wrangler が
   * 「env.test に足してください」と毎回警告する。
   */
  "env": {
    "test": {
      "vars": {
        "BETTER_AUTH_URL": "http://localhost:5173",
        "RENDER_URL": "https://yaritai100list-render.aiandrox.deno.net",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "yaritai100list",
          "database_id": "78718e38-9558-416b-b7c2-61b6a00be62d",
          "migrations_dir": "migrations",
        },
      ],
      "ratelimits": [
        {
          "name": "CREATE_RATE_LIMIT",
          "namespace_id": "1001",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "IMAGE_RATE_LIMIT",
          "namespace_id": "1002",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
  },
}
